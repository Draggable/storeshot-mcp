{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Written for Storeshot from https://code.claude.com/docs/en/plugins-reference.md (MCP servers) and https://cursor.com/docs/mcp.md (read 2026-11-02); no official JSON Schema exists. stdio servers only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mcpServers"],
  "properties": {
    "mcpServers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "args"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "env": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}
